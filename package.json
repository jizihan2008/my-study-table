{
  "name": "my-study-table",
  "version": "0.4.0",
  "description": "My Study Table - 桌面学习助手",
  "author": "jizihan2008",
  "license": "SEE LICENSE IN LICENSE.md",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check-project.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm test",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "build:portable": "electron-builder --win portable",
    "publish": "electron-builder --win nsis --publish always",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.mystudytable.app",
    "productName": "My Study Table",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "electron/**/*",
      "index.html",
      "css/**/*",
      "js/**/*",
      "lib/**/*",
      "icons/**/*",
      "*.bat"
    ],
    "publish": {
      "provider": "github",
      "owner": "jizihan2008",
      "repo": "my-study-table",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "imapflow": "^1.6.6",
    "katex": "^0.17.0",
    "lucide": "^0.469.0"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
}
